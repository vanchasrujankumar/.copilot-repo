{
  "name": "global-copilot-repo",
  "version": "1.0.0",
  "description": "Global Copilot repository with skills, agents, and MCP integration",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint . --ext .ts,.js,.json --fix",
    "lint:check": "eslint . --ext .ts,.js,.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky install",
    "mcp:start": "npx mcp start --config .mcp-config.json",
    "mcp:test": "npx mcp test --config .mcp-config.json",
    "agent:test": "jest agents/**/*.test.ts",
    "skill:test": "jest skills/**/*.test.ts",
    "build": "tsc",
    "clean": "rm -rf dist coverage .nyc_output",
    "dev": "nodemon --exec ts-node src/index.ts"
  },
  "keywords": [
    "copilot",
    "ai",
    "agents",
    "skills",
    "mcp",
    "tdd"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.1.0",
    "@modelcontextprotocol/server-github": "^0.1.0",
    "@modelcontextprotocol/server-postgres": "^0.1.0",
    "@modelcontextprotocol/server-slack": "^0.1.0",
    "@modelcontextprotocol/server-jira": "^0.1.0",
    "@modelcontextprotocol/server-notion": "^0.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
